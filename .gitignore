.ssh/

# Browser/session diagnostics can include cookies, tokens and private page content
.pi/
.agent-browser/
.playwright/
*.har
*.trace
trace*.zip

# Ad-hoc root screenshots are private; curated docs/screenshots remain publishable
/Screenshot*.png
/Screenshot*.jpg
/Screenshot*.jpeg
/Screenshot*.webp

# Local documentation and design notes stay private; curated screenshots live in /screenshots
/docs/
/server/RPC_CONTRACT*.md

# OS metadata and logs
.DS_Store
*.log
